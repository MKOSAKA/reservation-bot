# /etc/systemd/system/reservation-bot.service
# 起動中は常駐スケジューラとして動き、予定がなくなれば自インスタンスを停止する（AUTO_POWEROFF=1）。
[Unit]
Description=reservation-bot scheduler daemon
After=network-online.target chrony.service
Wants=network-online.target

[Service]
Type=simple
User=rbot
Group=rbot
WorkingDirectory=/opt/reservation-bot
# 起動のたびに Secrets Manager から秘密情報を展開する（"+" は root で実行）
ExecStartPre=+/opt/reservation-bot/infra/scripts/fetch-secrets.sh
EnvironmentFile=/etc/reservation-bot/config.env
EnvironmentFile=/etc/reservation-bot/secrets.env
ExecStart=/usr/bin/node dist/src/cli.js daemon
Restart=always
RestartSec=5
# 秘密情報と実行データの保護
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/reservation-bot

[Install]
WantedBy=multi-user.target
