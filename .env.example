# 本番では Secrets Manager から systemd の EnvironmentFile へ展開する（docs/ops/aws-setup.md 参照）
TZ=Asia/Tokyo
DATA_DIR=/var/lib/reservation-bot

# LaBOLA 施設メンバーログイン（ルネサンスもりのみや shop 3036 の会員番号またはメール）
LABOLA_MEMBER_ID=
LABOLA_PASSWORD=
# 登録済みカードのセキュリティコード（カード番号は保持しない）
LABOLA_CARD_CVV=
# 1 の時だけ STEP4 の「この内容で申込む」を押す。実予約テスト合格まで 0 のまま
LABOLA_ALLOW_SUBMIT=0

# storageState の暗号化キー（openssl rand -base64 32）
STATE_ENCRYPTION_KEY=

# スタジオル（メール + パスワード）。確定は STUDIOL_ALLOW_SUBMIT=1 の時だけ
STUDIOL_EMAIL=
STUDIOL_PASSWORD=
STUDIOL_ALLOW_SUBMIT=0

# 通知（自分宛て。Slack Incoming Webhook を第一候補、他は任意）
SLACK_WEBHOOK_URL=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO_USER_ID=
DISCORD_WEBHOOK_URL=

# 任意: Playwright 同梱以外の Chromium を使う場合
CHROMIUM_PATH=

# 停止運用（本番は bootstrap.sh が /etc/reservation-bot/config.env に設定）
AWS_REGION=ap-northeast-1
WAKE_INSTANCE_ID=
WAKE_ROLE_ARN=
WAKE_SCHEDULE_GROUP=reservation-bot
AUTO_POWEROFF=0
